---
interface Props { title: string; eyebrow?: string; description?: string }
const { title, eyebrow = 'Gabriel’s Auto Service', description } = Astro.props;
---
<header class="page-heading">
  <div class="wrap">
    <p class="kicker"><a href="/">Home</a><span aria-hidden="true">/</span>{eyebrow}</p>
    <h1>{title}</h1>
    {description && <p class="heading-description">{description}</p>}
  </div>
</header>
