---
import { services } from '../lib/site';
---
<div class="service-grid">
  {services.map((service, index) => (
    <article class="service-card">
      <img class="service-photo" src={service.image} alt="" width="380" height="200" loading="lazy" />
      <div class="service-info">
        <div class="service-marker"><img src={service.icon} width="34" height="34" alt="" /><span>0{index + 1}</span></div>
        <h3><a href={service.path}>{service.name}</a></h3>
        <p>{service.copy}</p>
        <a class="text-link" href={service.path} aria-label={`Explore ${service.name}`}>Explore service <span aria-hidden="true">↗</span></a>
      </div>
    </article>
  ))}
</div>
